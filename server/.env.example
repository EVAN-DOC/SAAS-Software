# === Server ===
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Set to "true" to serve the built-in 100-order sample dataset instead of
# calling Shopify/iCarry/Cashfree. Useful for local dev before you have
# credentials wired up. The dashboard UI is identical either way.
MOCK_MODE=true

# How long fetched data is cached in memory before re-fetching (seconds).
CACHE_TTL_SECONDS=60

# === Shopify Admin API ===
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10

# Option A — legacy custom-app flow, if your store's Admin still offers a
# static token directly: paste it here and leave the OAuth fields below blank.
SHOPIFY_ACCESS_TOKEN=

# Option B — today's "Dev Dashboard" apps only hand out a Client ID/Secret.
# Fill these in from the app's Settings tab, add
# http://localhost:4000/auth/shopify/callback as an Allowed redirection URL
# on that same page, then visit http://localhost:4000/auth/shopify in your
# browser once to install the app and mint an access token (cached in
# server/.data/shopify_token.json — you won't need to redo this).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers,read_fulfillments

# Leave unset to pull the store's entire order history. Set to a number of
# days (e.g. 90) once your order count grows large enough that re-fetching
# everything on every dashboard load gets slow.
SHOPIFY_ORDER_LOOKBACK_DAYS=

# === Cashfree Payment Gateway ===
# Dashboard > Developers > API Keys. Use sandbox creds while testing.
CASHFREE_ENV=sandbox
# CASHFREE_ENV=production
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
CASHFREE_API_VERSION=2023-08-01

# === iCarry ===
# iCarry does not publish a public API reference page; endpoint paths below
# are placeholders. Update ICARRY_BASE_URL and the paths in
# src/services/icarryService.js to match what iCarry gives you.
ICARRY_BASE_URL=https://ship.icarry.in/api
ICARRY_API_USERNAME=your_icarry_username
ICARRY_API_KEY=your_icarry_api_key
